{
  "name": "gtf-studio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src tests scripts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs *.json *.ts *.mjs",
    "licenses": "node scripts/dependency-licenses.mjs",
    "predev": "node scripts/build-assets.mjs",
    "prebuild": "node scripts/build-assets.mjs",
    "fonts:sync": "node scripts/sync-font-catalog.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.104.2",
    "boneyard-js": "1.10.0",
    "fabric": "7.4.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "iconsax-react": "0.0.8",
    "idb": "8.0.4",
    "jspdf": "4.2.1",
    "mp4-muxer": "5.2.2",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "onnxruntime-web": "1.30.0",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "webm-muxer": "5.1.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.5",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "17.6.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
