NEXT_PUBLIC_DATA_MODE=mock
# Set only when your own API implements docs/service-contracts.md.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example/v1

# View-only sharing. With a Vercel Blob store connected, shared designs get short links
# (/view/s/<id>); without it they still work but the link carries the design and is long.
# Create a Blob store in Vercel → Storage and connect it to this project to set this automatically.
# Locally, run `vercel env pull .env.local` to copy it from your project.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
